<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <NoWarn>$(NoWarn);IL2026</NoWarn>
    <PublishAot Condition="'$(COMPUTEWEAVE_NUGET_TESTS_PUBLISH_AOT)' == 'true'">true</PublishAot>
    <RestoreSources>
      https://api.nuget.org/v3/index.json;
      ..\..\artifacts;
    </RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ComputeWeave.Core" Version="$(PackageVersion)" />
    <PackageReference Include="ComputeWeave.D2D1" Version="$(PackageVersion)" />
  </ItemGroup>
</Project>
