<Project>
  <Import Project="..\build\Directory.Build.props" />

  <!--
    Solution builds cannot pass per project properties the way a project reference can, so a consumer that
    embeds this repository as a submodule places its own ComputeWeave.Build.props next to the solution, in a
    folder named after the solution. The consumer name is not hardcoded here.
  -->
  <PropertyGroup>
    <ComputeWeaveConsumerBuildProps Condition="'$(BuildingSolutionFile)' == 'true' and '$(SolutionName)' != '' and '$(CustomBeforeDirectoryBuildProps)' == ''">$(SolutionDir)$(SolutionName)\ComputeWeave.Build.props</ComputeWeaveConsumerBuildProps>
    <ComputeWeaveConsumerBuildProps Condition="!Exists('$(ComputeWeaveConsumerBuildProps)')"></ComputeWeaveConsumerBuildProps>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ComputeWeaveConsumerBuildProps)' != ''">
    <CustomAfterDirectoryBuildProps>$(SolutionDir)$(SolutionName)\ComputeWeave.Build.after.props</CustomAfterDirectoryBuildProps>
  </PropertyGroup>

  <Import Project="$(ComputeWeaveConsumerBuildProps)" Condition="'$(ComputeWeaveConsumerBuildProps)' != ''" />

  <!-- Centralized packaging metadata for published projects -->
  <PropertyGroup Condition="$(IsPackagedProject)">

    <!-- Package descriptions-->
    <Description Condition="'$(MSBuildProjectName)' == 'ComputeWeave'">
<![CDATA[A library for running C# code in parallel on the GPU using DirectX 12 and dynamically generated HLSL compute shaders. Derived from ComputeSharp, ComputeWeave adds declarative compute pipelines built from a compile-time descriptor, resource lifetime and cross-queue hazard tracking, Direct3D 11 and Direct3D 12 interoperation through shared fences and shared textures, and GPU memory budgeting, with no managed allocation on the steady-state submission path.]]>
    </Description>
    <Description Condition="'$(MSBuildProjectName)' == 'ComputeWeave.Core'">
<![CDATA[A library containing the fundamental types underpinning ComputeWeave. It is not intended for direct use by developers.]]>
    </Description>
    <Description Condition="'$(MSBuildProjectName)' == 'ComputeWeave.D2D1'">
<![CDATA[A companion library for ComputeWeave that writes Direct2D pixel shaders entirely in C# and registers them as ID2D1Effect. It shares the primitive types and HLSL intrinsics in ComputeWeave.Core but does not reference ComputeWeave, as these shaders are executed by Direct2D rather than on the Direct3D 12 compute queue.]]>
    </Description>
    <Description Condition="'$(MSBuildProjectName)' == 'ComputeWeave.D3D12MemoryAllocator'">
<![CDATA[An extension library for ComputeWeave that uses D3D12MA for graphics resource allocation.]]>
    </Description>
    <Description Condition="'$(MSBuildProjectName)' == 'ComputeWeave.Dxc'">
<![CDATA[An extension library for ComputeWeave that includes the DXC compiler and enables shader reflection.]]>
    </Description>

    <!-- Package tags, where the shared list does not describe the package-->
    <PackageTags Condition="'$(MSBuildProjectName)' == 'ComputeWeave.D2D1'">dotnet;csharp;gpu;directx;direct2d;d2d1;pixel-shader;hlsl;shader;source-generator;computesharp;windows</PackageTags>
  </PropertyGroup>

  <!-- Additional properties for all source projects-->
  <PropertyGroup>

    <!-- Define SOURCE_GENERATOR as well for source generators -->
    <DefineConstants Condition="$(IsSourceGeneratorProject)">$(DefineConstants);SOURCE_GENERATOR</DefineConstants>

    <!-- Disable packing symbols for all analyzers -->
    <PackSymbols Condition="$(IsAnalyzersProject)">false</PackSymbols>

    <!-- Enable extended analyzer rules for all analyzers -->
    <EnforceExtendedAnalyzerRules Condition="$(IsAnalyzersProject)">true</EnforceExtendedAnalyzerRules>

    <!-- Check whether the project has a .targets file to bundle -->
    <IsTargetsFileAvailableForPacking>false</IsTargetsFileAvailableForPacking>
    <IsTargetsFileAvailableForPacking Condition="$(IsPackagedProject) AND Exists('$(MSBuildProjectName).targets')">true</IsTargetsFileAvailableForPacking>

    <!-- Same check for an optional README.md file to bundle -->
    <IsReadMeFileAvailableForPacking>false</IsReadMeFileAvailableForPacking>
    <IsReadMeFileAvailableForPacking Condition="$(IsPackagedProject) AND Exists('README.md')">true</IsReadMeFileAvailableForPacking>

    <!-- Same check for an optional LICENSE.txt file to bundle -->
    <IsLicenseFileAvailableForPacking>false</IsLicenseFileAvailableForPacking>
    <IsLicenseFileAvailableForPacking Condition="$(IsPackagedProject) AND Exists('LICENSE.txt')">true</IsLicenseFileAvailableForPacking>
  </PropertyGroup>

  <!-- Additional items for published projects -->
  <ItemGroup Condition="$(IsPackagedProject)" Label="Package">

    <!-- Pack the NuGet icon file -->
    <None Include="$(MSBuildThisFileDirectory)..\assets\icon.png" Pack="true" PackagePath="\" Visible="False" />

    <!-- Pack the third party license files -->
    <None Include="$(MSBuildThisFileDirectory)..\.github\LICENSE\*.txt" Pack="true" PackagePath="THIRD-PARTY-NOTICES" Visible="False" />

    <!-- Pack .targets files, if present -->
    <None Condition="$(IsTargetsFileAvailableForPacking)" Include="$(MSBuildProjectName).targets" PackagePath="buildTransitive" Pack="true" />
    <None Condition="$(IsTargetsFileAvailableForPacking)" Include="$(MSBuildProjectName).targets" PackagePath="build" Pack="true" />

    <!-- Pack the README file, if present -->
    <None Condition="$(IsReadMeFileAvailableForPacking)" Include="README.md" Pack="true" PackagePath="\" Visible="False" />

    <!-- Pack the license file, if present -->
    <None Condition="$(IsLicenseFileAvailableForPacking)" Include="LICENSE.txt" Pack="true" PackagePath="\" Visible="False" />
  </ItemGroup>

  <!--
    Setup the custom .targets to run as 'BeforeMicrosoftNETSdkTargets'. This is because we want to be able to read properties
    that are set in .csproj files, and set properties depending on those before the .NET SDK .targets are imported. This is
    necessary to ensure that the .NET tooling works correctly with some of them (eg. with 'IsAotCompatible'). Note that the
    .NET SDK doesn't use 'Exists' here, and '<Import>' supports multiple items, so we can just chain our .targets file directly.
  -->
  <PropertyGroup>
    <BeforeMicrosoftNETSdkTargets>$(BeforeMicrosoftNETSdkTargets);$(MSBuildThisFileDirectory)Directory.Build.BeforeMicrosoftNETSdkTargets.targets</BeforeMicrosoftNETSdkTargets>
  </PropertyGroup>
</Project>
